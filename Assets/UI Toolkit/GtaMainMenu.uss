.root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgb(10, 10, 10);
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
}

.hidden {
    display: none;
}

.hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 24px;
    -unity-text-align: middle-center;
    font-size: 31px;
    color: rgb(255, 255, 255);
}

.brightness-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0;
}

.left-panel {
    width: 45%;
    padding: 90px 40px 60px 110px;
    background-color: rgba(0, 0, 0, 0.55);
}

.title-block {
    margin-bottom: 60px;
    -unity-font-definition: url("project://database/Assets/BECKETT_.TTF?fileID=12800000&guid=fd67f1891e314d042afdaddb0c0557e2&type=3#BECKETT_");
}

.title-small {
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 8px;
    color: rgb(235, 235, 235);
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.9);
}

.title-big {
    font-size: 76px;
    -unity-font-style: bold;
    color: rgb(240, 165, 35);
    text-shadow: 4px 4px 0 rgba(0, 0, 0, 0.9);
}

.menu-item {
    height: 56px;
    margin: 0 0 6px 0;
    padding: 0 0 0 20px;
    font-size: 70px;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    color: rgb(255, 255, 255);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0.9);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    border-left-width: 6px;
    border-left-color: rgba(0, 0, 0, 0);
    transition-property: color, background-color, border-left-color;
    transition-duration: 0.12s;
    -unity-font-definition: url("project://database/Assets/pricedow.ttf?fileID=12800000&guid=fd5234b7a75c191428d688c2d0789536&type=3#pricedow");
}

.menu-item:hover {
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("project://database/Assets/pricedow.ttf?fileID=12800000&guid=fd5234b7a75c191428d688c2d0789536&type=3#pricedow");
    color: rgb(111, 111, 111);
}

.menu-item:focus {
    color: rgb(137, 137, 137);
    background-color: rgba(255, 255, 255, 0);
    border-left-color: rgb(255, 170, 0);
}

.menu-item:active {
    color: rgb(255, 255, 255);
    display: flex;
}

.options-screen {
    justify-content: center;
    align-items: center;
}

.options-panel {
    width: 121%;
    max-width: 1644px;
    padding: 40px 50px;
    background-color: rgba(0, 0, 0, 0);
    height: 99%;
    min-width: -49px;
}

.screen-title {
    font-size: 52px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    text-shadow: 3px 3px 0 rgba(0, 0, 0, 0.9);
    margin-bottom: 30px;
    -unity-font-definition: url("project://database/Assets/BECKETT_.TTF?fileID=12800000&guid=fd67f1891e314d042afdaddb0c0557e2&type=3#BECKETT_");
}

.back-item {
    margin-top: 20px;
}

.option-row {
    flex-direction: row;
    align-items: center;
    height: 56px;
    margin-bottom: 6px;
    padding: 0 16px 0 20px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 6px;
    border-left-color: rgba(0, 0, 0, 0);
    transition-property: background-color, border-left-color;
    transition-duration: 0.12s;
    -unity-font-definition: url("project://database/Assets/arial-black.ttf?fileID=12800000&guid=1c5d67e7f824a09418d9576ee6ab9c6b&type=3#arial-black");
    min-width: -103px;
    width: 1193px;
}

.option-row:focus {
    background-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgb(255, 170, 0);
}

.option-label {
    flex-grow: 1;
    font-size: 26px;
    -unity-font-style: normal;
    color: rgb(205, 205, 205);
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.9);
    -unity-font-definition: url("project://database/Assets/arial-black.ttf?fileID=12800000&guid=1c5d67e7f824a09418d9576ee6ab9c6b&type=3#arial-black");
}

.option-row:focus .option-label {
    color: rgb(255, 196, 60);
}

.option-value {
    width: 220px;
    -unity-text-align: middle-center;
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.arrow {
    width: 40px;
    height: 40px;
    margin: 0;
    padding: 0;
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(200, 200, 200);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.arrow:hover {
    color: rgb(255, 196, 60);
    background-color: rgba(0, 0, 0, 0);
}

.arrow:active {
    color: rgb(255, 255, 255);
}

.bar {
    width: 260px;
    height: 14px;
    margin: 0 8px;
    background-color: rgba(255, 255, 255, 0.15);
}

.bar-fill {
    width: 0;
    height: 100%;
    background-color: rgb(240, 165, 35);
}
