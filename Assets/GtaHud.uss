/* ===================== HUD (gameplay) ===================== */
.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    /* Fonte estilo GTA (opcional):
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Pricedown.ttf"); */
}

.hidden {
    display: none;
}

/* ---------- Canto superior direito ---------- */
.hud-top-right {
    position: absolute;
    top: 30px;
    right: 40px;
    flex-direction: row;
    align-items: flex-start;
}

.hud-stats {
    align-items: flex-end;
    margin-right: 14px;
    margin-top: 8px;
}

/* Barra de vida */
.health-bar {
    width: 170px;
    height: 16px;
    background-color: rgba(70, 8, 8, 0.9);
    border-width: 2px;
    border-color: rgb(0, 0, 0);
}

.health-fill {
    width: 100%;
    height: 100%;
    background-color: rgb(190, 30, 30);
}

/* Dinheiro */
.money-label {
    margin-top: 6px;
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(60, 140, 50);
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.95);
}

/* Arma + munição */
.weapon-box {
    align-items: center;
}

.weapon-icon {
    width: 96px;
    height: 96px;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.25);
    -unity-background-scale-mode: scale-to-fit;
}

.weapon-name {
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgba(255, 255, 255, 0.6);
}

.ammo-label {
    margin-top: 2px;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.95);
}

/* ---------- Minimapa (placeholder) ---------- */
.minimap {
    position: absolute;
    left: 40px;
    bottom: 40px;
    width: 200px;
    height: 200px;
    border-radius: 100px;
    border-width: 4px;
    border-color: rgb(0, 0, 0);
    background-color: rgb(30, 40, 30);
    -unity-background-scale-mode: scale-and-crop;
}

/* ---------- Dica de teclas ---------- */
.hud-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    -unity-text-align: middle-center;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.55);
}
